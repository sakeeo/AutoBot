# syntax=docker/dockerfile:1
# Worker: WhatsApp (Baileys), the bot pipeline, knowledge, Google Sheets sync. Holds the bot's secrets.

FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @autobot/worker --workspace @autobot/contracts --include-workspace-root --ignore-scripts
COPY packages packages
COPY apps/worker apps/worker
RUN cd apps/worker && node build.mjs
# The runtime needs only the third-party packages; the bundle already holds our own code.
RUN node -e "const p=require('./apps/worker/package.json');const d=Object.fromEntries(Object.entries(p.dependencies).filter(([k])=>!k.startsWith('@autobot/')));require('fs').writeFileSync('/tmp/runtime-package.json',JSON.stringify({name:'autobot-worker-runtime',private:true,dependencies:d}))"

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production DATA_DIR=/data PORT=4000 HOST=0.0.0.0
WORKDIR /app
COPY --from=build /tmp/runtime-package.json package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /src/apps/worker/dist ./dist
# A named volume copies this folder's owner on first use, so the unprivileged user can write to it.
RUN mkdir -p /data && chown 10002:10002 /data
USER 10002:10002
VOLUME /data
EXPOSE 4000
CMD ["node", "dist/main.js"]
