{
  "name": "autobot",
  "private": true,
  "version": "0.2.0",
  "description": "AutoBot — Balas WA Otomatis pakai AI",
  "author": "Kerabat Koding",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docker:init": "bash deploy/scripts/init.sh",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/docker-compose.yml logs -f web worker",
    "reset-account": "node scripts/reset-account.mjs",
    "docker:reset-account": "bash deploy/scripts/reset-account.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
